rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAllowedPair(pair) {
      return pair in [
        'EUR/USD', 'GBP/USD', 'USD/JPY', 'USD/CHF', 'AUD/USD', 'USD/CAD',
        'XAU/USD', 'XAG/USD', 'XPT/USD',
        'BTC/USD', 'ETH/USD', 'SOL/USD', 'XRP/USD',
        'AAPL', 'NVDA', 'TSLA', 'MSFT'
      ];
    }

    function isValidTraderAccount(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.email is string && data.email.size() <= 120 &&
             data.balance is number && data.balance >= 0.0 && data.balance <= 10000000.0 &&
             data.startingBalance is number && data.startingBalance > 0.0 && data.startingBalance <= 10000000.0 &&
             data.leverage is int && data.leverage >= 10 && data.leverage <= 500 &&
             data.maxDailyDrawdownPct is number && data.maxDailyDrawdownPct >= 1.0 && data.maxDailyDrawdownPct <= 50.0 &&
             data.killSwitchTriggered is bool &&
             data.requireTradeConfirm is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTradingBot(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 50 &&
             isAllowedPair(data.pair) &&
             data.strategy in [
               'EMA_CROSSOVER',
               'RSI_REVERSAL',
               'BREAKOUT_GRID',
               'MACD_MOMENTUM',
               'BOLLINGER_SQUEEZE',
               'LONDON_OPEN_ORB',
               'ICHIMOKU_CLOUD',
               'FIBONACCI_SWING'
             ] &&
             data.timeframe in ['1M', '5M', '15M', '1H', '4H', '1D'] &&
             data.status in ['ACTIVE', 'PAUSED'] &&
             data.lotSize is number && data.lotSize >= 0.01 && data.lotSize <= 10.0 &&
             data.stopLossPips is int && data.stopLossPips >= 5 && data.stopLossPips <= 500 &&
             data.takeProfitPips is int && data.takeProfitPips >= 5 && data.takeProfitPips <= 1000 &&
             data.riskPercent is number && data.riskPercent >= 0.25 && data.riskPercent <= 10.0 &&
             data.totalTrades is int && data.totalTrades >= 0 &&
             data.winningTrades is int && data.winningTrades >= 0 && data.winningTrades <= data.totalTrades &&
             data.realizedPnl is number && data.realizedPnl >= -10000000.0 && data.realizedPnl <= 10000000.0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTradeRecord(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.botId is string && data.botId.size() <= 128 &&
             data.botName is string && data.botName.size() >= 1 && data.botName.size() <= 60 &&
             isAllowedPair(data.pair) &&
             data.side in ['BUY', 'SELL'] &&
             data.status in ['OPEN', 'CLOSED'] &&
             data.lotSize is number && data.lotSize >= 0.01 && data.lotSize <= 10.0 &&
             data.entryPrice is number && data.entryPrice > 0.0 && data.entryPrice <= 10000000.0 &&
             data.closePrice is number && data.closePrice >= 0.0 && data.closePrice <= 10000000.0 &&
             data.stopLoss is number && data.stopLoss >= 0.0 && data.stopLoss <= 10000000.0 &&
             data.takeProfit is number && data.takeProfit >= 0.0 && data.takeProfit <= 10000000.0 &&
             data.realizedPnl is number && data.realizedPnl >= -10000000.0 && data.realizedPnl <= 10000000.0 &&
             data.pips is number && data.pips >= -100000.0 && data.pips <= 100000.0 &&
             data.closeReason in ['OPEN', 'TP_HIT', 'SL_HIT', 'BOT_EXIT', 'MANUAL_CLOSE'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'email', 'balance', 'startingBalance',
                         'leverage', 'maxDailyDrawdownPct', 'killSwitchTriggered',
                         'requireTradeConfirm', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'email', 'balance', 'startingBalance',
                         'leverage', 'maxDailyDrawdownPct', 'killSwitchTriggered',
                         'requireTradeConfirm', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTraderAccount(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidTraderAccount(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'balance', 'startingBalance', 'leverage',
                         'maxDailyDrawdownPct', 'killSwitchTriggered', 'requireTradeConfirm', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /bots/{botId} {
        allow get: if isOwner(userId) && isValidId(botId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(botId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'pair', 'strategy', 'timeframe', 'status',
                           'lotSize', 'stopLossPips', 'takeProfitPips', 'riskPercent',
                           'totalTrades', 'winningTrades', 'realizedPnl', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'pair', 'strategy', 'timeframe', 'status',
                           'lotSize', 'stopLossPips', 'takeProfitPips', 'riskPercent',
                           'totalTrades', 'winningTrades', 'realizedPnl', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTradingBot(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(botId) &&
                         isValidTradingBot(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'pair', 'strategy', 'timeframe', 'status',
                           'lotSize', 'stopLossPips', 'takeProfitPips', 'riskPercent',
                           'totalTrades', 'winningTrades', 'realizedPnl', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(botId);
      }

      match /trades/{tradeId} {
        allow get: if isOwner(userId) && isValidId(tradeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(tradeId) &&
                         incoming().keys().hasAll([
                           'userId', 'botId', 'botName', 'pair', 'side', 'status',
                           'lotSize', 'entryPrice', 'closePrice', 'stopLoss', 'takeProfit',
                           'realizedPnl', 'pips', 'closeReason', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'botId', 'botName', 'pair', 'side', 'status',
                           'lotSize', 'entryPrice', 'closePrice', 'stopLoss', 'takeProfit',
                           'realizedPnl', 'pips', 'closeReason', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTradeRecord(incoming(), userId);

        // Terminal state lock: only OPEN trades can be updated (e.g., modified SL/TP or CLOSED)
        allow update: if isOwner(userId) &&
                         isValidId(tradeId) &&
                         existing().status == 'OPEN' &&
                         isValidTradeRecord(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().botId == existing().botId &&
                         incoming().botName == existing().botName &&
                         incoming().pair == existing().pair &&
                         incoming().side == existing().side &&
                         incoming().lotSize == existing().lotSize &&
                         incoming().entryPrice == existing().entryPrice &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'status', 'closePrice', 'stopLoss', 'takeProfit',
                           'realizedPnl', 'pips', 'closeReason', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(tradeId);
      }
    }
  }
}
